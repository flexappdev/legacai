{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacai.app/schemas/v1/person.schema.json",
  "title": "Person",
  "type": "object",
  "required": ["id", "displayName", "living"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "displayName": { "type": "string" },
    "living": { "enum": [true, false, "unknown"], "description": "unknown is treated as living." },
    "minor": { "type": "boolean" },
    "relationship": { "type": "string" },
    "consents": {
      "type": "array",
      "description": "Append-only consent history.",
      "items": {
        "type": "object",
        "required": ["purpose", "scope", "given", "at"],
        "properties": {
          "purpose": { "enum": ["store", "share", "agent-context", "voice-likeness", "promote"] },
          "scope": { "$ref": "common.schema.json#/$defs/scope" },
          "given": { "type": "boolean" },
          "at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "evidence": { "type": "string", "description": "Item id of the signed consent, if any." }
        }
      }
    }
  }
}
