{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacai.app/schemas/v1/grant.schema.json",
  "title": "Grant",
  "description": "Access is denied unless a grant allows it.",
  "type": "object",
  "required": ["id", "grantee", "role", "scope", "layers", "maxSensitivity", "grantedBy", "from"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "grantee": { "type": "string", "description": "Person id, agent id, or 'public'." },
    "role": { "enum": ["owner", "guardian", "member", "reader", "executor", "agent", "public"] },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/layer" } },
    "maxSensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" },
    "kinds": { "type": "array", "items": { "type": "string" }, "description": "Optional narrowing to item/note kinds." },
    "grantedBy": { "type": "string" },
    "from": { "$ref": "common.schema.json#/$defs/timestamp" },
    "until": { "$ref": "common.schema.json#/$defs/timestamp" },
    "condition": { "type": "string", "description": "Release plan id that must have fired." }
  }
}
